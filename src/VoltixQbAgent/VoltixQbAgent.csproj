<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- QBFC is in-process COM and the agent's bitness MUST match the
         registered QBFC build: QuickBooks Desktop 2021 and earlier register
         32-bit QBFC, 2022+ (64-bit QB) register 64-bit. We build AnyCPU and
         publish BOTH win-x86 and win-x64 — run whichever matches the QB on
         the machine (the error message says which to try). -->
    <AssemblyName>VoltixQbAgent</AssemblyName>
    <Version>0.2.3</Version>
    <Description>Voltix QuickBooks Enterprise Desktop sync agent</Description>
  </PropertyGroup>

</Project>
